# ─────────────────────────────────────────────────────────────────────────────
# Yorki — Production Environment Variables
# Copy to .env on your server: cp env.production.example .env
# Never commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# Your app's public URL (used in invite/notification links)
APP_URL=https://task.goldenstoneworks.com/task

# SQLite storage
# Prefer a path outside the app folder so rebuilds never touch the DB.
YORKI_DB_DIR=/var/lib/yorki
# Or set a full file path instead:
# YORKI_DB_PATH=/var/lib/yorki/yorki.db

# Email delivery
RESEND_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
SMTP_REPLY_TO=info@yourdomain.com

# Google Calendar sync
GOOGLE_CALENDAR_ID=info@yourdomain.com
GOOGLE_CALENDAR_TIME_ZONE=America/Los_Angeles

# Choose one auth method:
# 1. Path to a service-account JSON file on the server
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/var/www/yorki/google-service-account.json

# 2. Or inline fields
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 3. Or base64-encoded JSON
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# ── Push notifications (all optional) ───────────────────────────────────────
# Alerts on phones/browsers work out of the box: Yorki creates its signing key by itself and keeps it
# in the database. Only set these to manage the key yourself (node scripts/generate-vapid-keys.cjs).
# Changing the key later makes every device turn notifications on again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Who the push services may contact (https URL or mailto:). Defaults to APP_URL when that is https.
# VAPID_SUBJECT=mailto:you@example.com
# Extra push-service hostnames to accept, comma separated (only if a new browser vendor appears).
# PUSH_EXTRA_HOSTS=
